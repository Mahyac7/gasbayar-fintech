{
  "name": "gasbayar-fintech",
  "version": "2.0.0",
  "description": "Flip-style interbank transfer MVP — Next.js full-stack app (double-entry ledger, idempotency, transfer state machine, mock bank). Demo build uses an in-memory store.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "demo": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/demo.ts",
    "cap:sync": "cap sync android",
    "android:apk": "cap sync android && cd android && ./gradlew assembleDebug"
  },
  "keywords": [
    "transfer",
    "ledger",
    "fintech",
    "mvp",
    "nextjs",
    "vercel"
  ],
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "swr": "^2.2.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
